# ROCm user-land, CMake & gcc
FROM rocm/dev-ubuntu-24.04:6.3.1-complete

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential cmake git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . /workspace

# Configure & build the membench target now so the image is “ready-to-run”.
RUN cmake -S . -B build && cmake --build build -j$(nproc)

# Land in a shell; override with your own CMD if you prefer.
CMD ["bash"]

